{
  "name": "@corvus/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multiplexed Discord gateway: boots N bots on injected discord.js clients, per-bot quarantine, flush-then-disconnect shutdown.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "start": "node ./dist/start.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "tsx src/db/seed.ts",
    "format": "prettier --check --ignore-unknown ."
  },
  "dependencies": {
    "@corvus/ai": "^0.1.0",
    "@corvus/spec": "^0.1.0",
    "discord.js": "^14.27.0",
    "drizzle-orm": "^0.44.0",
    "pg": "^8.13.0",
    "pg-boss": "^12.29.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.23.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
