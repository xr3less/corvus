# Corvus env checklist. Copy to `.env` and fill in — never commit real values.
# CI fails if code reads a variable not listed here.

# DATABASE_URL — Postgres connection string shared by gateway, web, and pg-boss.
DATABASE_URL=

# APP_URL — public base URL used for OAuth callbacks, invite links, and status links.
# IP-first: https://<server-ip>.nip.io (e.g. https://203-0-113-10.nip.io) until a real
# domain is purchased, then switch to https://<your-domain>. No real value here.
APP_URL=https://example.com

# DISCORD_CLIENT_ID — Corvus dashboard app id (OAuth login + invite links). Public, but kept in env.
DISCORD_CLIENT_ID=

# DISCORD_CLIENT_SECRET — dashboard OAuth secret (server-only, never NEXT_PUBLIC_).
DISCORD_CLIENT_SECRET=

# NOTE: WIRO_* and CREEM_* keys arrive with their own V1s
# (model router, billing) — do not add them here until then.

# --- AI model router (V1-2, T-router) ---
# WIRO_API_KEY — wiro.ai gateway key for the primary builder/persona lanes. Server-only, never NEXT_PUBLIC_.
WIRO_API_KEY=
# WIRO_BASE_URL — wiro OpenAI-compat origin (default https://llm.wiro.ai/v1). Override for dev/stub use.
WIRO_BASE_URL=
# OPENROUTER_API_KEY — fallback route (OpenRouter GLM-5.3-Flash). Server-only.
OPENROUTER_API_KEY=
# ZAI_API_KEY — pinned alternate route (direct api.z.ai). Server-only.
ZAI_API_KEY=
# DEEPSEEK_API_KEY — cheapest fallback route (direct api.deepseek.com). Server-only.
DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY — quality fallback route (reserved; skipped until an OpenAI-compat path exists). Server-only.
ANTHROPIC_API_KEY=

# --- Deploy (V1-8) ---
# Deployment wiring for infra/compose/compose.yml and .github/workflows/deploy.yml.
# Real values live in the repo's Actions secrets and in /opt/corvus/.env on the server.
# Never commit a real value here.

# TAG — image tag compose pulls for web/gateway. `stable` = latest pushed main build;
# set a commit SHA to pin or to roll back.
TAG=stable

# GHCR_OWNER — lowercase GitHub user/org that owns the GHCR packages
# (ghcr.io/<owner>/corvus-web, /corvus-gateway). Must match the owner the deploy
# workflow pushes to, or `compose pull` will 404.
GHCR_OWNER=

# --- Compose Postgres (interpolated by infra/compose/compose.yml) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=corvus

# --- GitHub Actions deploy secrets ---
# Set these in the repo UI (Settings -> Secrets and variables -> Actions), NOT in .env.
# Listed here as an empty checklist only:
# DEPLOY_HOST=     server IP/hostname the deploy SSH step connects to
# DEPLOY_USER=     SSH user on the server (e.g. root, or corvus)
# DEPLOY_SSH_KEY=  private key for that user (full PEM, BEGIN/END lines included)
